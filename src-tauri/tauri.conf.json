{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeTally",
  "version": "0.1.2",
  "identifier": "com.samfaid.codetally",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeTally",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMjk1MTk1M0E2QkRERjMKUldUejNXczZsVkVwckVJaGE0dldmVVErdFJRODQ1Z1ZiVkFwb3JjaHlXWU9lblVoL0pFUWgxS3gK",
      "endpoints": [
        "https://github.com/Xzese/CodeTally/releases/latest/download/latest.json"
      ]
    }
  }
}
